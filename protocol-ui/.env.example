# BagSweep protocol UI - environment. Copy to .env.local and fill.
# Testnet defaults (Robinhood Chain testnet, chainId 46630). Flip these to the mainnet
# deployment (deployed-addresses.mainnet.json + chain 4663) at go-live.

VITE_CHAIN_ID=46630
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ERC-4337 infra. NOTE: the MVP browser UI uses NEITHER URL below. The owner acts via direct
# EOA transactions (ownerExecute); the keeper runs the gasless, sponsored sweeps server-side and
# points ITS OWN keeper/.env BUNDLER_URL at the live Alto bundler (see BUNDLER_RUNBOOK.md; the
# keeper can use http://127.0.0.1:4337 directly). These two vars remain only for a possible
# future owner-gasless path, which would require adding EIP-712/ERC-7739 owner-signature support
# to the (currently audit-frozen) SmartAccount. See the design note in src/lib/aa.ts.
VITE_BUNDLER_URL=https://app.bagsweep.xyz/bundler
VITE_PAYMASTER_URL=
VITE_ENTRYPOINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Contracts (testnet, from deployed-addresses.json)
VITE_FACTORY=0x71f80182F16bA3A0a718B42B7B3EdFa7F40fA6fb
VITE_REGISTRY=0x61dC8e8ac0E9d442fb402f9e2aCdf61691e586E5
VITE_EXECUTOR=0x7d1c9702860d506593D5b473d9082db9f2f44ceb
VITE_PAYMASTER=0xc10A1585A7016fC8B0C2a809C4699467eBA1E642
VITE_USDG=0xDeFb1C0362229A59e3383d512cf462760b868fA7
VITE_BUYBACK=
# Testnet-only: a mock meme token to author a policy against.
VITE_TEST_MEME=0x330Bde928231842c24C0F2AB69762F465Edc2b9A
