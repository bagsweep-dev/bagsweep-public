# BagSweep protocol UI - environment. Copy to .env.local (gitignored) and adjust.
# Testnet defaults (Robinhood Chain testnet, chainId 46630) match the live demo at
# app.bagsweep.xyz/demo. Flip to the mainnet deployment (chain 4663) at go-live.

VITE_CHAIN_ID=46630
VITE_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ERC-4337 infra. NOTE: the MVP browser UI uses NEITHER URL below. The owner acts via direct
# EOA transactions (ownerExecute); the keeper runs the gasless, sponsored sweeps server-side.
# See the design note in src/lib/aa.ts and BUNDLER_RUNBOOK.md.
VITE_BUNDLER_URL=https://app.bagsweep.xyz/bundler
VITE_PAYMASTER_URL=
VITE_ENTRYPOINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# Contracts (testnet, G3 deploy 2026-08-05, from deployed-addresses.json)
VITE_FACTORY=0x81dc83cE97781F67018c9ee933cf29C77Cfee90c
VITE_REGISTRY=0xBC631a0e682cDdFCC3537D9a892b278604F64eDA
VITE_EXECUTOR=0x1E73c12b598aB3e47e43A5Bc17f1F84E440e7ef4
VITE_PAYMASTER=0x04b8824B7d71d87AA1e6C223Bf85713033828616
VITE_USDG=0x3D0962386114AC969fFC6e478cB51D7f883d5557
# No SweepBuyback on this testnet deploy; the flywheel card degrades to the concept + "live on mainnet".
VITE_BUYBACK=
# Testnet-only: the mock meme token to author a policy against (G3 mockMemeToken).
VITE_TEST_MEME=0xfe67050aF12824800F1594Fbe6FFCFBAfa0016Ea
# The live soak account shown as the public "see it live" example (has an active policy + real sweeps).
VITE_DEMO_ACCOUNT=0x6Ca3685599886D086ED67411E1Ad82f27DB0eA61
