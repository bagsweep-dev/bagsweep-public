# ── Deployer (COLD) ──
# Private key of the deployer wallet (WITHOUT 0x prefix). This is the cold
# admin/owner key. It must NOT be the keeper: keep deployer != keeper (the deploy
# script enforces this on mainnet). Move ownership to the timelock after deploy.
DEPLOYER_KEY=

# ── RPC ──
# Robinhood Chain Mainnet RPC (default: public endpoint)
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Robinhood Chain Testnet RPC (default: public endpoint)
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ── Contracts ──
# USDG address on Robinhood Chain mainnet (skip on testnet — MockUSDG is deployed)
USDG_ADDRESS=0x5fc5360d0400a0fd4f2af552add042d716f1d168
# EntryPoint v0.8 canonical address (deployed automatically if missing)
ENTRY_POINT=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108
# Keeper address that signs UserOps. This is the PUBLIC address of the keeper
# service's KEEPER_KEY (a HOT key, kept in the keeper service env, NOT here). On
# mainnet it MUST be set and MUST differ from the deployer; the deploy script
# enforces deployer != keeper. Defaults to the deployer on testnet/local only.
KEEPER_ADDRESS=

# Sponsor signer PUBLIC address for the verifying paymaster. deploy.js sets it on
# the SweepPaymaster; only UserOps signed by this address get gas-sponsored.
# Defaults to KEEPER_ADDRESS if unset. Its PRIVATE key (SPONSOR_KEY) lives in the
# keeper service env, NOT here.
SPONSOR_SIGNER=

# ── Sanctioned venues (set at deploy, or later via the executor's owner) ──
# Sweeps revert until a real meme→USDG DEX router is sanctioned.
SWEEP_ROUTER=
# USDG→stock DEX router, only needed for the STOCKS / SPLIT destinations.
STOCK_ROUTER=
# A stock token allowed as a STOCKS destination (e.g. an RH tokenized equity).
SANCTIONED_STOCK=

# ── Keeper Service ──
BUNDLER_URL=https://bundler.testnet.chain.robinhood.com
POLL_INTERVAL_MS=30000
EVAL_INTERVAL_MS=60000
