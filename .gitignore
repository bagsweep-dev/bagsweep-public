node_modules/
data/

# Secrets — never commit. contracts/.env holds DEPLOYER_KEY / KEEPER_KEY.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Hardhat build output
contracts/artifacts/
contracts/cache/
keeper/artifacts/

# Keeper runtime state (demand-gate retention snapshots — per-owner, regenerated at runtime)
keeper/entitlements.json

# Tooling / editor cruft
# .qoder/ and its repowiki/ cache are generated by the Qoder IDE and have previously
# scraped credentials out of deploy scripts and .env files into committed markdown.
# Never track either, in this repo or the public mirror.
.qoder/
repowiki/
*.log

# Ad-hoc scratch scripts (one-off on-chain scans / probes, not part of the keeper or contracts)
_*.mjs
_*.js
